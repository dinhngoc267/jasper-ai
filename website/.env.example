# Jasper AI — environment variables
# Copy to .env.local for local dev. Real values live in .env.local (gitignored)
# and in Vercel's project env vars for production/preview — never commit real
# values here.

# --- Supabase ---------------------------------------------------------------
# Project URL and anon (public) key — safe for the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, bypasses Row Level Security. NEVER expose
# to the client. Used by every /admin data fetch and server action.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (email) ----------------------------------------------------------
# Used for the internal new-inquiry notification and the BUILD 3 daily
# digest. Sandbox mode (no verified sending domain yet) can only deliver to
# the account's own verified address (jasper.le@edge8.ai).
RESEND_API_KEY=

# --- Site URL ------------------------------------------------------------------
# Base URL used to build absolute deep links (e.g. the digest email's links
# into /admin/leads). Falls back to Vercel's VERCEL_URL, then a hardcoded
# production URL, if unset — set explicitly once jasper-ai.com is live.
NEXT_PUBLIC_SITE_URL=

# --- Cron ----------------------------------------------------------------------
# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`
# when it calls /api/cron/digest. Generate with `openssl rand -hex 32`.
CRON_SECRET=

# --- Optional / future -------------------------------------------------------
# # STRIPE_SECRET_KEY=
# # STRIPE_WEBHOOK_SECRET=
# # SENTRY_DSN=
