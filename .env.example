# Jasper AI — environment variables (copy real values into website/.env.local, never commit them)

# Supabase — project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=          # Project URL (https://….supabase.co)
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # anon public key (safe for browser)
SUPABASE_SERVICE_ROLE_KEY=         # service_role key (server-only, keep secret)

# Google AI Studio — image/content generation
GEMINI_API_KEY=

# Resend — transactional + marketing email
RESEND_API_KEY=
# RESEND_DOMAIN=                   # optional — set once a real domain is bought and verified

# Lark notifications — optional, leave unset to disable
# LARK_APP_ID=
# LARK_APP_SECRET=
# LARK_WEBHOOK_URL=
